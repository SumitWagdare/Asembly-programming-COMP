PRACTICAL NO 8 – BCD TO HEXADECIMAL
ROLL NO – C02160
section .data
msg1 db "Enter 5 digit BCD number: "
len1 equ $-msg1
msg2 db "HEX Equivalent: "
len2 equ $-msg2
newline db 10
section .bss
num resb 6
hex resb 5
section .text
global _start
_start:
; print message
mov rax,1
mov rdi,1
mov rsi,msg1
mov rdx,len1
syscall
; read input
mov rax,0
mov rdi,0
mov rsi,num
mov rdx,6
syscall
; BCD → decimal conversion
mov rsi,num
mov rcx,5
mov rax,0
mov rbx,10
convert:
mov rdx,0
mul rbx
mov dl,[rsi]
sub dl,30h
add rax,rdx
inc rsi
loop convert
; decimal → HEX ASCII
mov rbx,16
mov rdi,hex
mov rcx,0
hex_loop:
mov rdx,0
div rbx
push rdx
inc rcx
cmp rax,0
jne hex_loop
display:
pop rdx
cmp dl,9
jbe digit
add dl,7
digit:
add dl,30h
mov [rdi],dl
inc rdi
loop display
; print message
mov rax,1
mov rdi,1
mov rsi,msg2
mov rdx,len2
syscall
; print HEX result
mov rax,1
mov rdi,1
mov rsi,hex
mov rdx,5
syscall
; newline
mov rax,1
mov rdi,1
mov rsi,newline
mov rdx,1
syscall
; exit
mov rax,60
xor rdi,rdi
syscall

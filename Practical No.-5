Practical No.-5

;Write an X86/64 ALP to find the largest of given Byte/Word/Dword/64-bitnumbers.


section .data
array db 11h,19h,13h,12h,14h
msg1 db 10,"ALP to find the largest number in an array",10
msg1_len equ $-msg1
msg2 db 10,"The Array contains the elements:",10
msg2_len equ $-msg2
msg3 db 10,10,"The Largest number in the array is:",10
msg3_len equ $-msg3
msg4 db 10
msg4_len equ $-msg4
section .bss
counter resb 1
result resb 2
%macro write 2
mov rax,1
mov rdi,1
mov rsi,%1
mov rdx,%2
syscall
%endmacro
section .text
global _start
_start:
write msg1,msg1_len
write msg2,msg2_len
mov byte [counter],5
mov rsi,array
next:
mov al,[rsi]
push rsi
call disp
write msg4,msg4_len
pop rsi
inc rsi
dec byte [counter]
jnz next
write msg3,msg3_len
Hitendra Hemraj Yeole
CO2197
mov byte [counter],5
mov rsi,array
mov al,0
repeat:
cmp al,[rsi]
jg skip
mov al,[rsi]
skip:
inc rsi
dec byte [counter]
jnz repeat
call disp
mov rax,60
xor rdi,rdi
syscall
; Display routine (Hex output)
disp:
mov bl,al
mov rdi,result
mov cx,2
up1:
rol bl,4
mov al,bl
and al,0Fh
cmp al,09h
jg add_37
add al,30h
jmp store
add_37:
add al,37h
store:
mov [rdi],al
inc rdi
dec cx
jnz up1
write result,2
write msg4,msg4_len
ret
